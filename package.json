{
  "name": "powview",
  "version": "0.1.9",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && bun scripts/precompress.ts && bun run build:cli",
    "build:cli": "bun build cli/powview.ts --target bun --minify --outfile dist/cli/powview.js",
    "build:npm": "bun run build && bun build server.ts --target bun --minify --outfile start.js && bun scripts/pack-npm.ts",
    "pack:npm": "bun scripts/pack-npm.ts",
    "start": "bun run server.ts",
    "postinstall": "rm -rf node_modules/ssh2/lib/protocol/crypto/build node_modules/cpu-features/build",
    "typecheck": "bun check",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check",
    "lint": "oxlint --deny-warnings",
    "demo:db": "docker compose -f demo/docker-compose.yml up -d",
    "demo:down": "docker compose -f demo/docker-compose.yml down -v"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@daypicker/react": "^10.0.2",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql-formatter": "^15.9.0",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.1.18",
    "vite": "^8.0.0"
  }
}
